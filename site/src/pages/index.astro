<script is:inline>
  // Scale each demo page to fit its case. Cheaper and more robust than
  // container-query maths, and it survives resize and font-size changes.
  const fit = () => {
    document.querySelectorAll('.glass').forEach((g) => {
      g.style.setProperty('--s', (g.clientWidth / 1280).toFixed(4));
    });
  };
  fit();
  addEventListener('resize', fit);
  if (window.ResizeObserver) {
    const ro = new ResizeObserver(fit);
    document.querySelectorAll('.glass').forEach((g) => ro.observe(g));
  }

  // One click puts the command on the clipboard. navigator.clipboard needs a
  // secure context, which a plain-HTTP preview is not, so fall back rather
  // than leave the button silently doing nothing.
  const copyText = async (text) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:-1000px;opacity:0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      ta.remove();
      return ok;
    }
  };

  document.querySelectorAll('.copy').forEach((btn) => {
    const label = btn.querySelector('.ci');
    btn.addEventListener('click', async () => {
      const ok = await copyText(btn.dataset.copy);
      label.textContent = ok ? 'copied' : 'press ctrl+c';
      btn.setAttribute('data-done', '');
      clearTimeout(btn._t);
      btn._t = setTimeout(() => {
        label.textContent = 'copy';
        btn.removeAttribute('data-done');
      }, 1800);
    });
  });
</script>
